# Copy this file to ".env" and fill in your own values.
# NEVER upload the real .env file to GitHub.

# PostgreSQL connection string.
# Local example (PostgreSQL installed on your computer):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momenta?schema=public"
# Cloud example (Neon) - use the DIRECT connection string, not the "pooled" one:
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Secret for signing login tokens. At least 32 random characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-secret-at-least-32-chars"

# How long a login token stays valid (examples: 2h, 1d, 7d).
JWT_EXPIRES_IN="1d"

# Port for the server (cloud hosts like Render set this automatically).
PORT=3000

# Which websites may call the API. "*" = any site.
# For production you can list your React site, e.g. "https://my-app.netlify.app,http://localhost:5173"
CORS_ORIGIN="*"

# development | production
NODE_ENV="development"

# ---- Seed (npm run db:seed) ----
# In development the seed uses known demo passwords (see README).
# In production nothing is created unless you set these:
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="a-strong-password"
# SEED_DEMO_DATA="true"
# SEED_DEMO_PASSWORD="another-strong-password"

# Optional: separate database for automated tests (default: momenta_test on localhost)
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/momenta_test?schema=public"
